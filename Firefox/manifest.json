{
  "manifest_version": 3,
  "name": "Domain Price Unwithholder",
  "version": "1.0",
  "author": "HenryZxTan",
  "homepage_url": "https://github.com/HenryZxTan/Domain-Price-Unwithholder",
  "description": "Reveals hidden 'Price Withheld' and agent guide values on Domain.com.au seamless from page source.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["*://*.domain.com.au/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "domain-price-unwithholder@HenryZxTan.local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
